<% layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">

        <div class="col-lg-8">

            <!-- Heading -->
            <h2 class="fw-bold mb-4">
                <%= listing.title %>
            </h2>

            <!-- Card -->
            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <!-- Image -->
                <img 
                    src="<%= listing.image.url %>" 
                    class="card-img-top show-img"
                    alt="listing_image"
                >

                <!-- Body -->
                <div class="card-body p-4">
                    <!-- Host -->
                    <p class="text-muted mb-2">
                        Hosted in <%= listing.location %>, <%= listing.country %>
                    </p>

                    <div class="host-info mb-4">

                        <div class="host-avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Hosted by
                            </small>

                            <h6 class="mb-0 fw-semibold">
                                <%= listing.owner.username %>
                            </h6>

                        </div>

                    </div>

                    <!-- Description -->
                    <p class="card-text fs-5">
                        <%= listing.description %>
                    </p>

                    <!-- Price -->
                    <h4 class="mt-4 fw-bold">
                        ₹ <%= listing.price.toLocaleString("en-IN") %>
                        <span class="fs-6 text-muted fw-normal">
                            / night
                        </span>
                    </h4>

                    <!-- Location -->
                    <div class="mt-3">

                        <span class="badge bg-light text-dark border p-2 fs-6">
                            📍 <%= listing.location %>, <%= listing.country %>
                        </span>

                    </div>

                    <% if(currUser && listing.owner._id.equals(currUser._id)) {%>
                    <!-- Buttons -->
                        <div class="d-flex gap-3 mt-5">
                            <!-- Edit -->
                            <a 
                                href="/listings/<%= listing._id %>/edit"
                                class="btn btn-dark px-4 rounded-pill"
                            >
                                Edit
                            </a>

                            <!-- Delete -->
                            <form 
                                method="POST"
                                action="/listings/<%= listing._id %>?_method=DELETE"
                            >

                                <button class="btn btn-outline-danger rounded-pill px-4">
                                    Delete
                                </button>

                            </form>
                        </div>
                    <% } %>
                </div>

            </div>

        </div>

    </div>

    <!-- Leave a Review Section -->
    <div class="row justify-content-center mt-5">
        <div class="col-lg-8">

            <!-- Leave Review Card -->
            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-4">
                        Leave a Review
                    </h3>

                    <form
                        action="/listings/<%= listing._id %>/reviews"
                        method="POST"
                        class="needs-validation"
                        novalidate
                    >

                        <!-- Rating -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                Rating
                            </label>

                            <fieldset class="starability-slot">
                                <legend class="visually-hidden">Rating</legend>

                                <input
                                    type="radio"
                                    id="no-rate"
                                    class="input-no-rate"
                                    name="review[rating]"
                                    value="1"
                                    checked
                                    aria-label="No rating."
                                />

                                <input
                                    type="radio"
                                    id="first-rate1"
                                    name="review[rating]"
                                    value="1"
                                />
                                <label for="first-rate1" title="Terrible">
                                    1 star
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate2"
                                    name="review[rating]"
                                    value="2"
                                />
                                <label for="first-rate2" title="Not good">
                                    2 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate3"
                                    name="review[rating]"
                                    value="3"
                                />
                                <label for="first-rate3" title="Average">
                                    3 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate4"
                                    name="review[rating]"
                                    value="4"
                                />
                                <label for="first-rate4" title="Very good">
                                    4 stars
                                </label>

                                <input
                                    type="radio"
                                    id="first-rate5"
                                    name="review[rating]"
                                    value="5"
                                />
                                <label for="first-rate5" title="Amazing">
                                    5 stars
                                </label>
                            </fieldset>
                        </div>

                        <!-- Comment -->
                        <div class="mb-4">
                            <label
                                for="comment"
                                class="form-label fw-semibold"
                            >
                                Your Review
                            </label>

                            <textarea
                                class="form-control rounded-3"
                                id="comment"
                                name="review[comment]"
                                rows="5"
                                placeholder="Share your experience..."
                                required
                            ></textarea>

                            <div class="invalid-feedback">
                                Please write a review.
                            </div>
                        </div>

                        <!-- Submit -->
                        <button
                            type="submit"
                            class="btn btn-dark rounded-pill px-5"
                        >
                            Submit Review
                        </button>

                    </form>

                </div>
            </div>

            <!-- Reviews -->
            <% if(listing.reviews.length > 0) {%>
            <div class="mt-5">

                <h3 class="fw-bold mb-4">
                    Guest Reviews
                    <span class="text-muted fs-5">
                        (<%= listing.reviews.length %>)
                    </span>
                </h3>

                <% if (listing.reviews.length > 0) { %>

                    <div class="row g-4">

                        <% listing.reviews.forEach(review => { %>

                            <div class="col-md-6">

                                <div class="review-card h-100">

                                    <div class="d-flex justify-content-between align-items-center mb-3">

                                        <div class="review-user">

                                            <div class="review-avatar">
                                                <i class="fa-solid fa-user"></i>
                                            </div>

                                            <div>
                                                <h6 class="mb-0 fw-semibold">
                                                    <%= review.author.username %>
                                                </h6>

                                                <small class="text-muted">
                                                    Verified Stay
                                                </small>
                                            </div>

                                        </div>

                                        <p
                                            class="starability-result m-0"
                                            data-rating="<%= review.rating %>"
                                        >
                                            Rated:
                                            <%= review.rating %>
                                            stars
                                        </p>

                                    </div>

                                    <p class="review-text">
                                        <%= review.comment %>
                                    </p>

                                    <div class="d-flex justify-content-end mt-4">

                                        <form
                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            method="POST"
                                        >
                                            <button
                                                type="submit"
                                                class="btn btn-outline-danger btn-sm rounded-pill review-delete-btn"
                                            >
                                                <i class="fa-solid fa-trash me-2"></i>
                                                Delete Review
                                            </button>
                                        </form>

                                    </div>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="empty-review text-center">

                        <i class="fa-regular fa-comments fs-1"></i>

                        <h5 class="mt-3">
                            No Reviews Yet
                        </h5>

                        <p class="text-muted">
                            Be the first person to share your experience.
                        </p>

                    </div>

                <% } %>

            </div>
            <% } %>

            <div class="mt-5">
                <h3>Where you'll be</h3>

                <div
                    id="map"
                    data-coordinates='<%= JSON.stringify(listing.geometry.coordinates) %>'
                    data-title="<%= listing.title %>"
                    data-location="<%= listing.location %>"
                    data-country="<%= listing.country %>"
                ></div>
            </div>
        </div>
    </div>
</div>