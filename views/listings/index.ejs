<% layout("/layouts/boilerplate") %>


<style>
    .tax-info {
        display: none;
    }
</style>

<div id="filters">
    <div class="filter active" data-category="trending">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>

    <div class="filter" data-category="rooms">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </div>

    <div class="filter" data-category="iconic">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
    </div>

    <div class="filter" data-category="mountains">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </div>

    <div class="filter" data-category="castles">
        <i class="fa-brands fa-fort-awesome-alt"></i>
        <p>Castles</p>
    </div>

    <div class="filter" data-category="pools">
        <i class="fa-solid fa-water-ladder"></i>
        <p>Amazing Pools</p>
    </div>

    <div class="filter" data-category="camping">
        <i class="fa-solid fa-house-flag"></i>
        <p>Camping</p>
    </div>

    <div class="filter" data-category="farms">
        <i class="fa-solid fa-igloo"></i>
        <p>Farms</p>
    </div>

    <div class="filter" data-category="arctic">
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<div class="row mt-3">

    <% for(let listing of allListings) { %>

        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">

            <a href="/listings/<%= listing._id %>" class="listing-link">

                <div class="card listing-card">

                    <img 
                        src="<%= listing.image.url %>" 
                        class="card-img-top" 
                        alt="listing_image"
                        style="height: 20rem;"
                    >
                    <div class="card-img-overlay"></div>

                    <div class="card-body">

                        <p class="card-text">

                            <b><%= listing.title %></b>
                            <br>

                            ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %> / night
                            <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                        </p>    

                    </div>

                </div>

            </a>

        </div>

    <% } %>

</div>


<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");

        for(info of taxInfo) {
            if(info.style.display != "inline") {
                info.style.display = "inline";
            }else{
                info.style.display = "none";
            }
        }
    })
</script>