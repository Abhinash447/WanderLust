<% layout("/layouts/boilerplate") %>

    <style>
        .tax-info {
            display: none;
        }

        .no-results {
            padding: 80px 20px;
            text-align: center;
        }

        .no-results-icon {
            font-size: 60px;
            margin-bottom: 20px;
        }

        .no-results h3 {
            font-weight: 600;
            margin-bottom: 10px;
        }

        .no-results p {
            color: #6c757d;
            margin-bottom: 25px;
        }

        .no-results .btn {
            padding: 10px 24px;
        }
    </style>

    <div id="filters">

        <div class="filter active" data-category="trending">
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
        </div>

        <div class="filter" data-category="rooms">
            <i class="fa-solid fa-bed"></i>
            <p>Rooms</p>
        </div>

        <div class="filter" data-category="iconic">
            <i class="fa-solid fa-mountain-city"></i>
            <p>Iconic Cities</p>
        </div>

        <div class="filter" data-category="mountains">
            <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
        </div>

        <div class="filter" data-category="castles">
            <i class="fa-brands fa-fort-awesome-alt"></i>
            <p>Castles</p>
        </div>

        <div class="filter" data-category="pools">
            <i class="fa-solid fa-water-ladder"></i>
            <p>Amazing Pools</p>
        </div>

        <div class="filter" data-category="camping">
            <i class="fa-solid fa-house-flag"></i>
            <p>Camping</p>
        </div>

        <div class="filter" data-category="farms">
            <i class="fa-solid fa-igloo"></i>
            <p>Farms</p>
        </div>

        <div class="filter" data-category="arctic">
            <i class="fa-solid fa-snowflake"></i>
            <p>Arctic</p>
        </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">

                <label class="form-check-label" for="switchCheckDefault">
                    Display total after taxes
                </label>
            </div>
        </div>

    </div>

    <% if (allListings.length===0) { %>

        <div class="no-results">
            <div class="no-results-icon">
                <i class="fa-solid fa-location-dot"></i>
            </div>

            <h3>No listings found</h3>

            <% if (search) { %>
                <p>
                    We couldn't find any listings for
                    <strong>"<%= search %>"</strong>
                </p>
                <% } else { %>
                    <p>There are no listings available right now.</p>
                    <% } %>

                        <a href="/listings" class="btn btn-dark rounded-pill">
                            Explore All Listings
                        </a>
        </div>

        <% } else { %>

            <div class="row mt-3" id="listing-container">

                <% for (let listing of allListings) { %>

                    <div class="col-lg-4 col-md-6 col-sm-12 mb-4 listing-item" data-category="<%= listing.category %>">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <div class="card listing-card">

                                <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>"
                                    style="height: 20rem;">

                                <div class="card-img-overlay"></div>

                                <div class="card-body">
                                    <p class="card-text">
                                        <b>
                                            <%= listing.title %>
                                        </b>
                                        <br>

                                        ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %> / night

                                            <i class="tax-info">
                                                &nbsp;&nbsp;+18% GST
                                            </i>
                                    </p>
                                </div>

                            </div>
                        </a>
                    </div>

                    <% } %>

            </div>

            <div id="filter-no-results" class="no-results" style="display: none;">
                <div class="no-results-icon">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
            
                <h3>No listings found</h3>
            
                <p>
                    We couldn't find any listings in this category.
                </p>
            
                <button type="button" id="show-all-listings" class="btn btn-dark rounded-pill">
                    Explore All Listings
                </button>
            </div>

            <% } %>

                <script>

                    const filters = document.querySelectorAll(".filter");
                        const listings = document.querySelectorAll(".listing-item");
                        const filterNoResults = document.getElementById("filter-no-results");
                        const showAllButton = document.getElementById("show-all-listings");
                        const taxSwitch = document.getElementById("switchCheckDefault");

                        filters.forEach(filter => {
                            filter.addEventListener("click", () => {
                                const category = filter.dataset.category;

                                filters.forEach(item => {
                                    item.classList.remove("active");
                                });

                                filter.classList.add("active");

                                let visibleCount = 0;

                                listings.forEach(listing => {
                                    const listingCategory = listing.dataset.category;

                                    const shouldShow =
                                        category === "trending" ||
                                        listingCategory === category;

                                    listing.style.display = shouldShow ? "" : "none";

                                    if (shouldShow) {
                                        visibleCount++;
                                    }
                                });

                                filterNoResults.style.display =
                                    visibleCount === 0 ? "block" : "none";
                            });
                        });

                        showAllButton?.addEventListener("click", () => {
                            const trendingFilter = document.querySelector(
                                '.filter[data-category="trending"]'
                            );

                            trendingFilter.click();
                        });

                        taxSwitch.addEventListener("change", () => {
                            document.querySelectorAll(".tax-info").forEach(info => {
                                info.style.display = taxSwitch.checked ? "inline" : "none";
                            });
                        });
                </script>